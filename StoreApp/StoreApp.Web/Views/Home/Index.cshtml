@using StoreApp.Web.Models
@model ProductListViewModel

<div class="row">
    <div class="col-md-3">
        @await Component.InvokeAsync("CategoriesList")
    </div>
    <div class="col-md-9">

        @if (!Model.Products.Any())
        {
            <p>No products available.</p>
        }

        @foreach (var product in Model.Products)
        {
            <div class="card mb-3" style="max-width: 540px;">
                <div class="row g-0">
                    @* <div class="col-md-4">
                        <img src="@product.ImageUrl" class="img-fluid rounded-start" alt="@product.Name">
                    </div> *@
                    <div class="col-md-12">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="card-title">@product.Name</h4>
                                <p class="card-text">@product.Description</p>
                            </div>
                            <span class="badge rounded-pill text-bg-success" style="font-size: 0.85rem;">
                                <small class="text-muted" style="font-size: 0.75rem;">Price: @product.Price $</small>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div page-model="@Model.PageInfo" page-action="Index">
            @if (Model.PageInfo.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination" style="list-style: none; display: flex; flex-wrap: wrap; gap: 5px;">
                        @for (int i = Math.Max(1, Model.PageInfo.CurrentPage - 2); i <= Math.Min(Model.PageInfo.TotalPages,
                                                                                    Model.PageInfo.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == Model.PageInfo.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>

</div>