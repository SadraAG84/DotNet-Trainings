@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model IdentityApp.Models.AppRole

<h2>Edit Role</h2>
<hr>
<form asp-action="Edit" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-controller="Users" asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
<hr>
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>User Name</th>
            <th>Full Name</th>
            <th>Email</th>
            <th style="width: 50px;"></th>
        </tr>
    </thead>
    <tbody>
        @if(ViewBag.Users != null)
        {
            @if(ViewBag.Users.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center">No users found.</td>
                </tr>
            }
            @foreach (var user in ViewBag.Users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.UserName</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Edit</a>
                        
                    </td>
                </tr>
            }
        }
    </tbody>
</table>