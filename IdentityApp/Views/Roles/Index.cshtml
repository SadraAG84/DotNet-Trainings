@model IEnumerable<IdentityApp.Models.AppRole>


<a asp-controller="Roles" asp-action="Create" class="btn btn-sm btn-success mb-2">Create New Role</a>
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Role Name</th>
            <th>Users</th>
            <th style="width: 125px;"></th>
        </tr>
    </thead>
    <tbody>
        @if(Model.Count() == 0)
        {
            <tr>
                <td colspan="5" class="text-center">No roles found.</td>
            </tr>
        }
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Id</td>
                <td>@role.Name</td>
                <td>Users List</td>
                <td>
                    <a asp-controller="Roles" asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@role.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this role?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>