@{
    ViewBag.Title = "Forgot Password Confirmation";
}

<h2>Forgot Password Confirmation</h2>

<p>
    If your email is registered and confirmed, you will receive a password reset link.
</p>

@* Display the reset link for demonstration/testing purposes *@
@if (ViewBag.ResetLink != null)
{
    <div>
        <strong>Reset Link (for demo/testing):</strong>
        <br />
        <a href="@ViewBag.ResetLink">@ViewBag.ResetLink</a>
    </div>
}